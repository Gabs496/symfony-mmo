{# Rendered by App\Stream\MapObjectStream: one block per action #}

{% block append %}
    <turbo-stream action="append" target="map_field_objects">
        <template>
            {{ include('parts/map_object.html.twig', {gameObject: entity}) }}
        </template>
    </turbo-stream>
{% endblock %}

{% block update %}
    <turbo-stream action="update" target="map_object_{{ id }}" method="morph">
        <template>
            {{ component("Render:MapRenderTemplate", {gameObject: entity}) }}
        </template>
    </turbo-stream>
{% endblock %}

{% block remove %}
    <turbo-stream action="replace" target="map_object_{{ id }}" method="morph">
        <template>
            <div id="map_object_{{ id }}" class="animate__animated animate__zoomOut animate__faster" style="transition: height .5s;">
                {{ component("Render:MapRenderTemplate", {gameObject: entity}) }}
                <script>
                    (function () {
                        const element = document.getElementById('map_object_{{ id }}');
                        if (!element) return;
                        element.style.height = element.offsetHeight + 'px';
                        setTimeout(function () {
                            element.style.height = 0;
                            setTimeout(function () { element.remove(); }, 500);
                        }, 500);
                    })();
                </script>
            </div>
        </template>
    </turbo-stream>
{% endblock %}
