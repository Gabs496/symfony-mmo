<div {{ attributes.defaults(
    stimulus_action('live', '$render', 'server.item_bag_changed_' ~ this.bagId ~ '@document')
) }}>
    <div class="card">
        <div class="card-header bg-info">
            <div class="position-absolute top-0 end-0">
                <button class="btn btn-sm btn-secondary" data-bs-toggle="collapse" data-bs-target="#inventory">
                    <span class="fas fa-times"></span>
                    <span>{{ "Close"|trans }}</span>
                </button>
            </div>
            {{ 'backpack'|trans|capitalize }}
            <div>
                <turbo-frame class="progress" id="item_bag_fullness_{{ this.bag.id }}">
                    <div class="progress-bar bg-primary" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="width: {{ this.fullness*100 }}%;"></div>
                </turbo-frame>
            </div>
        </div>
        <turbo-frame class="card-body d-flex flex-wrap" id="item_bag_content_{{ this.bag.id }}">
            {% for item in this.items %}
                {{ component('Render:ItemBagSlotRenderTemplate', {item: item}) }}
            {% endfor %}
        </turbo-frame>
    </div>
</div>
