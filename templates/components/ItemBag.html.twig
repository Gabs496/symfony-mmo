<div {{ attributes }}>
    <div {{ custom_turbo_stream_listen(this.streamTopic) }}></div>
    <div class="card">
        <div class="card-header bg-info">
            <div class="position-absolute top-0 end-0">
                <button class="btn btn-sm btn-secondary" data-bs-toggle="collapse" data-bs-target="#inventory">
                    <span class="fas fa-times"></span>
                    <span>{{ "Close"|trans }}</span>
                </button>
            </div>
            {{ 'backpack'|trans|capitalize }}
            <div>
                <div class="progress" id="item_bag_fullness_{{ this.bagId }}">
                    {{ include('parts/item_bag_fullness.html.twig', {fullness: this.fullness}) }}
                </div>
            </div>
        </div>
        <turbo-frame class="card-body d-flex flex-wrap" id="item_bag_content_{{ this.bagId }}">
            {% for item in this.items %}
                {{ component('Render:ItemBagSlotRenderTemplate', {item: item}) }}
            {% endfor %}
        </turbo-frame>
    </div>
</div>
